#: includes/class-veazen-settings-page.php:182
#, php-format
msgid "Synced %d products to Veazen."
msgstr "已同步 %d 个商品到 Veazen。"

#: includes/class-veazen-settings-page.php:201
msgid "Pick a synced product and a quantity between 1 and 100,000."
msgstr "请选择一个已同步的商品，数量在 1 到 100,000 之间。"

#. translators: %s: error message.
#: includes/class-veazen-settings-page.php:215
#, php-format
msgid "Batch request failed: %s"
msgstr "批次申请失败：%s"

#: includes/class-veazen-settings-page.php:217
msgid "Batch requested — codes are being generated in the cloud."
msgstr "批次已提交——防伪码正在云端生成。"

#: includes/class-veazen-settings-page.php:233
msgid "No download available yet."
msgstr "暂无可下载内容。"

#. translators: %s: error message.
#: includes/class-veazen-settings-page.php:235
#, php-format
msgid "Export failed: %s"
msgstr "导出失败：%s"

#. translators: %s: error message.
#: includes/class-veazen-settings-page.php:254
#, php-format
msgid "Activation failed: %s"
msgstr "激活失败：%s"

#. translators: %d: number of activated codes.
#: includes/class-veazen-settings-page.php:257
#, php-format
msgid "Activated %d codes."
msgstr "已激活 %d 个防伪码。"

#: includes/class-veazen-settings-page.php:277
msgid "Connect your store"
msgstr "连接你的商店"

#: includes/class-veazen-settings-page.php:278
msgid ""
"Paste an API key from your Veazen console (Settings → API keys). The key is "
"stored encrypted and codes never leave the cloud."
msgstr "粘贴 Veazen 控制台生成的 API 密钥（Settings → API keys）。密钥加密存储，防伪码明文永不离开云端。"

#: includes/class-veazen-settings-page.php:286
msgid "Advanced: custom API endpoint"
msgstr "高级：自定义 API 地址"

#: includes/class-veazen-settings-page.php:291
msgid "Connect to Veazen"
msgstr "连接 Veazen"

#: includes/class-veazen-settings-page.php:300
msgid "Status:"
msgstr "状态："

#. translators: 1: tenant name, 2: plan name.
#: includes/class-veazen-settings-page.php:305
#, php-format
msgid "Connected to %1$s (%2$s plan)"
msgstr "已连接到 %1$s（%2$s 套餐）"

#: includes/class-veazen-settings-page.php:312
msgid "Product sync"
msgstr "商品同步"

#: includes/class-veazen-settings-page.php:313
msgid ""
"Sync your WooCommerce catalog to Veazen. Tick \"Veazen protection\" on a "
"product to keep it synced automatically on every save."
msgstr "把 WooCommerce 商品目录同步到 Veazen。在商品上勾选“Veazen 防伪保护”，每次保存都会自动同步。"

#: includes/class-veazen-settings-page.php:317
msgid "Sync all products now"
msgstr "立即同步全部商品"

#: includes/class-veazen-settings-page.php:320
msgid "Code batches"
msgstr "防伪码批次"

#: includes/class-veazen-settings-page.php:325
