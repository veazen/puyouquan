msgstr "全部激活"

#: includes/class-veazen-verify-widget.php:55
#: includes/class-veazen-verify-widget.php:81
msgid "Enter the code from your product label…"
msgstr "输入商品标签上的验证码…"

#: includes/class-veazen-verify-widget.php:56
#: includes/class-veazen-verify-widget.php:82
msgid "Verify"
msgstr "验证"

#: includes/class-veazen-verify-widget.php:57
msgid "Checking…"
msgstr "查询中…"

#: includes/class-veazen-verify-widget.php:58
msgid "Genuine product — first verification."
msgstr "正品——首次验证。"

#: includes/class-veazen-verify-widget.php:59
msgid "This code has been verified before. Stay alert."
msgstr "该码此前已被验证过，请提高警惕。"

#: includes/class-veazen-verify-widget.php:60
msgid "This code has not been activated by the manufacturer."
msgstr "该码尚未被厂家激活。"

#: includes/class-veazen-verify-widget.php:61
