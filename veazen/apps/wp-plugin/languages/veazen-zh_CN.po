msgid "WooCommerce is not active."
msgstr "WooCommerce 未启用。"

#: includes/class-veazen-product-sync.php:155
msgid "Veazen protection"
msgstr "Veazen 防伪保护"

#: includes/class-veazen-product-sync.php:175
msgid "Enable anti-counterfeit codes for this product"
msgstr "为该商品启用防伪码"

#: includes/class-veazen-product-sync.php:180
msgid "Synced to Veazen. Saved changes sync automatically."
msgstr "已同步到 Veazen。保存修改后会自动同步。"

#: includes/class-veazen-product-sync.php:182
msgid ""
"Not synced yet — save with this box ticked, or run a full sync from the "
"Veazen page."
msgstr "尚未同步——勾选此项后保存，或到 Veazen 页面执行全量同步。"

#: includes/class-veazen-settings-page.php:116
msgid "Please paste a valid Veazen API key (it starts with vz_)."
msgstr "请粘贴有效的 Veazen API 密钥（以 vz_ 开头）。"

