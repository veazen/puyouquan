#: includes/class-veazen-settings-page.php:143
#, php-format
msgid "Connection failed: %s"
msgstr "连接失败：%s"

#: includes/class-veazen-settings-page.php:151
msgid "Store connected to Veazen."
msgstr "商店已连接到 Veazen。"

#: includes/class-veazen-settings-page.php:164
msgid "Disconnected. Your cloud data is untouched."
msgstr "已断开连接。云端数据不受影响。"

#. translators: %s: error message.
#: includes/class-veazen-settings-page.php:179
#, php-format
msgid "Sync failed: %s"
msgstr "同步失败：%s"

