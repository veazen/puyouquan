#: veazen.php
msgid "https://veazen.app"
msgstr "https://veazen.app"

#. Description of the plugin
#: veazen.php
msgid ""
"Anti-counterfeit verification and product traceability for WooCommerce, "
"powered by the Veazen cloud."
msgstr "面向 WooCommerce 的商品防伪验证与溯源，由 Veazen 云平台驱动。"

#: includes/class-veazen-api-client.php:54
msgid "The store is not connected to Veazen yet."
msgstr "商店尚未连接 Veazen。"

#. translators: %d: HTTP status code.
#: includes/class-veazen-api-client.php:80
#, php-format
msgid "Cloud request failed with status %d."
msgstr "云端请求失败，状态码 %d。"

#: includes/class-veazen-dashboard-widget.php:38
msgid "Veazen — verifications"
msgstr "Veazen — 验证统计"

#: includes/class-veazen-dashboard-widget.php:82
msgid "verifications in the last 7 days"
msgstr "最近 7 天验证次数"

#: includes/class-veazen-dashboard-widget.php:86
msgid "open risk alerts"
msgstr "待处理风险告警"

#: includes/class-veazen-dashboard-widget.php:88
msgid "Open Veazen →"
msgstr "打开 Veazen →"

#: includes/class-veazen-orders.php:80
msgid "Connect the store to Veazen first."
msgstr "请先将商店连接到 Veazen。"

#: includes/class-veazen-orders.php:86
msgid "Bound serial:"
msgstr "已绑定序列号："

#: includes/class-veazen-orders.php:93
msgid "Scan or type a serial…"
msgstr "扫描或输入序列号…"

#: includes/class-veazen-orders.php:94
msgid "Bind serial to order"
msgstr "将序列号绑定到订单"

#: includes/class-veazen-orders.php:104
msgid "Print Veazen shipping label"
msgstr "打印 Veazen 发货标签"

#: includes/class-veazen-orders.php:105
msgid ""
"Pulls a code from the on-demand pool, activates it and binds it to this "
"order in one step (Lite)."
msgstr "从按需码池取出一个码，激活并一步绑定到本订单（Lite 模式）。"

#: includes/class-veazen-orders.php:136 includes/class-veazen-orders.php:176
#: includes/class-veazen-settings-page.php:89
