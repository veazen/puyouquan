msgid "Order or serial missing."
msgstr "缺少订单或序列号。"

#. translators: %s: error message.
#: includes/class-veazen-orders.php:160
#, php-format
msgid "Binding failed: %s"
msgstr "绑定失败：%s"

#: includes/class-veazen-orders.php:164
msgid "Serial bound to order."
msgstr "序列号已绑定到订单。"

#: includes/class-veazen-orders.php:183
msgid "Order not found."
msgstr "未找到订单。"

#: includes/class-veazen-orders.php:187
msgid "No synced Veazen product on this order."
msgstr "本订单中没有已同步到 Veazen 的商品。"

