msgstr "无效码——该商品可能是假货。"

#: includes/class-veazen-verify-widget.php:63
msgid "Verification service unreachable. Try again shortly."
msgstr "验证服务暂时不可用，请稍后再试。"

#: assets/verify-block.js:9
msgid "Veazen Verify"
msgstr "Veazen 验证"

#: assets/verify-block.js:10
msgid "Product authenticity check box, verified against the Veazen cloud."
msgstr "商品真伪查询组件，通过 Veazen 云端验证。"

#: assets/verify-block.js:18
msgid ""
"Veazen verification box — customers enter a product code here. Preview on "
"the front end."
msgstr "Veazen 验证框——消费者在此输入商品验证码。前台可预览。"

#: includes/class-veazen-returns.php:40
msgid "Active (in circulation)"
msgstr "已激活（流通中）"

#: includes/class-veazen-returns.php:42
msgid "Verified — locked by the first buyer"
msgstr "已验证——已被首位买家锁定"

#: includes/class-veazen-returns.php:44
msgid "Retired (replaced by a new label)"
msgstr "已回收（已换发新标签）"

#: includes/class-veazen-returns.php:46
msgid "Officially refurbished"
msgstr "官方翻新"

#: includes/class-veazen-returns.php:48
msgid "Inactive (not activated yet)"
msgstr "未激活"

#: includes/class-veazen-returns.php:50
msgid "Flagged by the brand"
msgstr "已被品牌方标记"

#. translators: %s: error message returned by the cloud.
#: includes/class-veazen-returns.php:95
#, php-format
msgid "Release failed: %s"
msgstr "释放失败：%s"

#. translators: %d: how many times this code has been released.
#: includes/class-veazen-returns.php:98
#, php-format
msgid "Code released for resale (release #%d) — the next scan shows green again."
msgstr "该码已释放再售（第 %d 次释放）——下次扫码将重新显示绿色。"

#. translators: %s: error message returned by the cloud.
#: includes/class-veazen-returns.php:117
#, php-format
msgid "Return registration failed: %s"
msgstr "退货登记失败：%s"

#. translators: %s: resulting code status.
#: includes/class-veazen-returns.php:120
#, php-format
msgid "Return registered — code status is now \"%s\"."
msgstr "退货已登记——码状态现为“%s”。"

#: includes/class-veazen-returns.php:133
msgid "Returns check"
msgstr "退货核验"

#: includes/class-veazen-returns.php:134
msgid "Look up a returned item without changing its state, then release it for resale or register the return. Pasted serials may keep their hyphens."
msgstr "查询退货商品的码（不会改变其状态），再决定释放再售或登记退货。粘贴的序列号可以保留横线。"

#: includes/class-veazen-returns.php:138
msgid "Serial from the product label…"
msgstr "商品标签上的序列号…"

#: includes/class-veazen-returns.php:139
msgid "Check code"
msgstr "查询该码"

#. translators: %s: error message returned by the cloud.
#: includes/class-veazen-returns.php:149
#, php-format
msgid "Lookup failed: %s"
msgstr "查询失败：%s"

#: includes/class-veazen-returns.php:166
msgid "intact"
msgstr "完好未刮开"

#: includes/class-veazen-returns.php:167
msgid "revealed by the buyer"
msgstr "已被买家刮开"

#: includes/class-veazen-returns.php:169
msgid "none (scan-only code)"
msgstr "无（纯扫码型）"

#: includes/class-veazen-returns.php:174
msgid "Scans"
msgstr "扫码次数"

#: includes/class-veazen-returns.php:175
msgid "Last scan"
msgstr "末次扫码"

#: includes/class-veazen-returns.php:176
msgid "Releases"
msgstr "释放次数"

#: includes/class-veazen-returns.php:177
msgid "Scratch layer"
msgstr "刮码涂层"

#: includes/class-veazen-returns.php:180
msgid "Replaced by"
msgstr "已由新码替代"

#: includes/class-veazen-returns.php:186
msgid "Serial"
msgstr "序列号"

