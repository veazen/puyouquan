{
  "name": "@veazen/api",
  "version": "0.1.0",
  "private": true,
  "description": "Veazen cloud API (NestJS) \u2014 code generation, verification and traceability backend",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:dev": "ts-node src/main.ts",
    "test:e2e": "jest --config jest-e2e.config.cjs --runInBand",
    "db:migrate": "prisma migrate deploy && node scripts/pin-dev-app-role.mjs",
    "db:seed": "ts-node prisma/seed.ts",
    "openapi": "node -e \"process.env.EMIT_OPENAPI=require(\\\"path\\\").resolve(__dirname,\\\"../../docs/openapi.json\\\"); require(\\\"./dist/main.js\\\")\"",
    "bench": "node scripts/bench-verify.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.2.1",
    "@veazen/crypto": "0.1.0",
    "@veazen/shared": "0.1.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "5.10.1",
    "maxmind": "^4.3.23",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autocannon": "^8.0.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
