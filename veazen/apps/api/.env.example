# Veazen API environment variables (PROJECT_PLAN §11).
# Phase 0: none of these are consumed yet — they are wired up in Phase 1.
# Copy to .env for local development (infra/docker-compose.yml provides the services).

# PostgreSQL 16 connection string (Prisma)
DATABASE_URL=postgres://veazen:veazen@localhost:5432/veazen

# Redis 7 — cache, rate limiting, BullMQ queues
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO in local dev) — batch exports, label PDFs
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=veazen
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 32 bytes hex — envelope-encryption master key for tenant Ed25519 private keys.
# The API must refuse to start when missing (enforced from Phase 1, §9.1).
MASTER_KEY=

# Secret for backend-user JWTs (access 15min / refresh 7d)
JWT_SECRET=

# Base URL of the public verification pages (QR codes point here)
PUBLIC_VERIFY_BASE_URL=https://verify.veazen.app

# SMTP for alert/notification e-mails (mailhog in local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Path to MaxMind GeoLite2-City.mmdb (downloaded and placed manually)
GEOIP_DB_PATH=

# GDPR mode: when true, scan_events stores IPs truncated to /24
ANONYMIZE_IP=false
