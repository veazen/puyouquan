---
// The brand's signature motif (§2.5): monospace grouped serial + scan light
// band + Verified badge. Reused on hero, docs and the verify page design.
const { serial = 'A1B2C-D3E4F-6H7J8-K9M0N' } = Astro.props;
---

<div class="serial-bar" aria-label={`Example verified serial ${serial}`}>
  <span class="serial">{serial}</span>
  <span class="badge">Verified</span>
  <span class="scanline" aria-hidden="true"></span>
</div>

<style>
  .serial-bar {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.4rem;
    border: 1px solid var(--color-etch);
    border-radius: 6px;
    background: var(--color-basalt-deep);
  }
  .serial {
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    font-size: 0.95rem;
  }
  .badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-jade);
    border: 1px solid var(--color-jade);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    animation: badge-in 0.6s ease-out both;
    animation-delay: 1.2s;
  }
  .scanline {
    position: absolute;
    inset: 0 auto 0 -40%;
    width: 35%;
    background: linear-gradient(90deg, transparent, rgba(63, 163, 124, 0.18), transparent);
    animation: scan 2.6s ease-in-out infinite;
  }
  @keyframes scan {
    to {
      left: 105%;
    }
  }
  @keyframes badge-in {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scanline {
      display: none;
    }
    .badge {
      animation: none;
    }
  }
</style>
