---
// Waitlist form (§8 Phase 2): replaces the temp site's mailto. Posts to the
// cloud waitlist endpoint (public, rate-limited). PUBLIC_API_URL is inlined
// at build time; defaults to the platform API domain.
// Status messages are passed to the (locale-agnostic) script via data-*.
import { getDict, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = getDict(locale).waitlist;
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'https://api.veazen.app/api/v1';
---

<form
  id="waitlist-form"
  data-api={apiUrl}
  data-msg-ok={t.ok}
  data-msg-rate={t.rateLimited}
  data-msg-fallback={t.fallbackPrefix}
  data-msg-fallback-link={t.fallbackLink}
  data-mailto-subject={t.mailtoSubject}
>
  <div class="row">
    <input
      required
      type="email"
      name="email"
      placeholder={t.emailPlaceholder}
      autocomplete="email"
    />
    <input type="text" name="brand" placeholder={t.brandPlaceholder} />
  </div>
  <div class="row">
    <input type="url" name="website" placeholder={t.websitePlaceholder} />
    <select name="monthly_units" aria-label={t.unitsAria}>
      <option value="">{t.unitsPlaceholder}</option>
      <option value="lt_1k">{t.unitsLt1k}</option>
      <option value="1k_10k">{t.units1k10k}</option>
      <option value="10k_100k">{t.units10k100k}</option>
      <option value="gt_100k">{t.unitsGt100k}</option>
    </select>
  </div>
  <button type="submit">{t.submit}</button>
  <p class="status" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement;
  const status = form.querySelector('.status') as HTMLParagraphElement;
  const msgs = form.dataset;

  // Until the cloud API is live, failures degrade to a prefilled mailto so
  // no early-access lead is ever lost. Once api.veazen.app deploys, the
  // form starts writing to the waitlist table with zero changes here.
  function mailtoFallback(data: Record<string, unknown>): void {
    status.textContent = msgs.msgFallback ?? '';
    const link = document.createElement('a');
    const body = `email: ${String(data.email ?? '')}\nbrand: ${String(data.brand ?? '')}\nwebsite: ${String(data.website ?? '')}\nunits/month: ${String(data.monthly_units ?? '')}`;
    link.href = `mailto:hello@veazen.app?subject=${encodeURIComponent(msgs.mailtoSubject ?? 'Early access request')}&body=${encodeURIComponent(body)}`;
    link.textContent = msgs.msgFallbackLink ?? '';
    link.style.color = 'var(--color-jade)';
    status.appendChild(link);
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    status.textContent = '…';
    try {
      const res = await fetch(`${form.dataset.api}/waitlist`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        status.textContent = msgs.msgOk ?? '';
        status.classList.add('ok');
        form.querySelectorAll('input, select, button').forEach((el) => {
          (el as HTMLInputElement).disabled = true;
        });
      } else if (res.status === 429) {
        status.textContent = msgs.msgRate ?? '';
      } else {
        mailtoFallback(data);
      }
    } catch {
      mailtoFallback(data);
    }
  });
</script>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    max-width: 34rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }
  input,
  select {
    background: var(--color-basalt-deep);
    border: 1px solid var(--color-etch);
    border-radius: 4px;
    color: var(--color-limestone);
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
  }
  input:focus,
  select:focus {
    outline: none;
    border-color: var(--color-jade);
  }
  button {
    background: var(--color-jade);
    color: var(--color-basalt);
    font-weight: 600;
    border: 0;
    border-radius: 4px;
    padding: 0.8rem 1.2rem;
    font-size: 0.95rem;
    cursor: pointer;
  }
  button:hover {
    background: var(--color-jade-deep);
  }
  .status {
    min-height: 1.2rem;
    font-size: 0.85rem;
    color: var(--color-limestone-dim);
  }
  .status.ok {
    color: var(--color-jade);
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
