---
// Waitlist form (§8 Phase 2): replaces the temp site's mailto. Posts to the
// cloud waitlist endpoint (public, rate-limited). PUBLIC_API_URL is inlined
// at build time; defaults to the platform API domain.
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'https://api.veazen.app/api/v1';
---

<form id="waitlist-form" data-api={apiUrl}>
  <div class="row">
    <input required type="email" name="email" placeholder="Work email *" autocomplete="email" />
    <input type="text" name="brand" placeholder="Brand name" />
  </div>
  <div class="row">
    <input type="url" name="website" placeholder="Website" />
    <select name="monthly_units" aria-label="Units per month">
      <option value="">Units / month</option>
      <option value="lt_1k">&lt; 1,000</option>
      <option value="1k_10k">1,000 – 10,000</option>
      <option value="10k_100k">10,000 – 100,000</option>
      <option value="gt_100k">&gt; 100,000</option>
    </select>
  </div>
  <button type="submit">Request early access</button>
  <p class="status" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement;
  const status = form.querySelector('.status') as HTMLParagraphElement;
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    status.textContent = '…';
    try {
      const res = await fetch(`${form.dataset.api}/waitlist`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        status.textContent = "You're on the list — we'll be in touch.";
        status.classList.add('ok');
        form.querySelectorAll('input, select, button').forEach((el) => {
          (el as HTMLInputElement).disabled = true;
        });
      } else if (res.status === 429) {
        status.textContent = 'Too many attempts — please try again in a minute.';
      } else {
        status.textContent = 'Something went wrong — email us at hello@veazen.app.';
      }
    } catch {
      status.textContent = 'Network error — email us at hello@veazen.app.';
    }
  });
</script>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    max-width: 34rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }
  input,
  select {
    background: var(--color-basalt-deep);
    border: 1px solid var(--color-etch);
    border-radius: 4px;
    color: var(--color-limestone);
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
  }
  input:focus,
  select:focus {
    outline: none;
    border-color: var(--color-jade);
  }
  button {
    background: var(--color-jade);
    color: var(--color-basalt);
    font-weight: 600;
    border: 0;
    border-radius: 4px;
    padding: 0.8rem 1.2rem;
    font-size: 0.95rem;
    cursor: pointer;
  }
  button:hover {
    background: var(--color-jade-deep);
  }
  .status {
    min-height: 1.2rem;
    font-size: 0.85rem;
    color: var(--color-limestone-dim);
  }
  .status.ok {
    color: var(--color-jade);
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
