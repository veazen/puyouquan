---
import Base from '../layouts/Base.astro';
---

<Base
  title="Privacy Policy — Veazen"
  description="Veazen privacy policy."
  path="/privacy"
>
  <main>
    <p class="kicker">Legal</p>
    <h1>Privacy Policy</h1>
    <div class="card" style="margin-top:1.5rem">
      <p class="dim">
        <strong>Draft skeleton — not yet legally reviewed.</strong> The final
        policy is being prepared with counsel and will replace this page before
        general availability. It will cover, at minimum:
      </p>
      <ul class="dim">
        <li>What we collect when a product code is scanned (IP-derived coarse location, device signals) and why</li>
        <li>How device fingerprints are salted, truncated and used strictly for anti-fraud purposes</li>
        <li>Cross-tenant risk signals: what is aggregated and what is never shared</li>
        <li>IP anonymization options for brands operating under GDPR</li>
        <li>Data retention windows and deletion requests</li>
        <li>Contact: hello@veazen.app</li>
      </ul>
    </div>
  </main>
</Base>

<style>
  h1 { font-size: 2rem; margin-top: 0.4rem; }
  ul { margin-top: 0.8rem; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.9rem; }
</style>
