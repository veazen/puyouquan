---
import Base from '../layouts/Base.astro';
import SerialBar from '../components/SerialBar.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { SLOGAN } from '../tokens';
---

<Base
  title="Veazen — Anti-counterfeit verification & traceability for growing brands"
  description="One cryptographically signed code per item. Consumers scan, you see every scan. Anti-counterfeit protection and supply-chain traceability that installs in minutes on WooCommerce."
  path="/"
>
  <main>
    <section class="hero">
      <p class="kicker">Anti-counterfeit · Traceability</p>
      <h1>{SLOGAN.en}</h1>
      <p class="sub dim">
        Every item gets a unique, cryptographically signed code. Consumers scan it;
        you see every scan on a map. Counterfeits and gray-market diversion stop
        being invisible.
      </p>
      <SerialBar />
      <div class="hero-cta">
        <a class="primary" href="#waitlist">Request early access</a>
        <a class="secondary" href="/features">See how it works</a>
      </div>
    </section>

    <section>
      <p class="kicker">Three steps</p>
      <h2>From install to first verified scan in minutes</h2>
      <div class="steps">
        <div class="card">
          <p class="step-n">01</p>
          <h3>Generate</h3>
          <p class="dim">
            Connect the WooCommerce plugin, pick a product, and generate signed
            codes in the cloud — or print-ready label sheets for small batches.
          </p>
        </div>
        <div class="card">
          <p class="step-n">02</p>
          <h3>Attach</h3>
          <p class="dim">
            Print QR labels yourself or send the batch file to your print shop.
            Codes stay inactive until you activate them at factory exit.
          </p>
        </div>
        <div class="card">
          <p class="step-n">03</p>
          <h3>Scan</h3>
          <p class="dim">
            Customers verify with one scan — green, yellow or red. You get scan
            locations, duplicate alerts and gray-market signals in real time.
          </p>
        </div>
      </div>
    </section>

    <section>
      <p class="kicker">Why Veazen</p>
      <h2>Enterprise-grade protection without the enterprise contract</h2>
      <div class="grid2">
        <div class="card">
          <h3>Signed, not just unique</h3>
          <p class="dim">
            Every code carries an Ed25519 signature verified server-side.
            Guessing serial numbers gets counterfeiters nowhere.
          </p>
        </div>
        <div class="card">
          <h3>Evidence-grade logs</h3>
          <p class="dim">
            Scan history is append-only and anchored in a daily Merkle digest
            chain — usable as evidence in takedowns and channel disputes.
          </p>
        </div>
        <div class="card">
          <h3>Dark-code confirmation</h3>
          <p class="dim">
            A scratch-off hidden code gives buyers a one-time proof of purchase
            authenticity. Second redemptions raise instant alerts.
          </p>
        </div>
        <div class="card">
          <h3>HTTPS everywhere, by domain design</h3>
          <p class="dim">
            Verification lives on veazen.app — a domain with HSTS preloading
            enforced at the protocol level, so verify pages can't be downgraded.
          </p>
        </div>
      </div>
    </section>

    <section id="waitlist">
      <p class="kicker">Early access</p>
      <h2>Join the waitlist</h2>
      <p class="dim" style="max-width:34rem; margin-bottom:1.2rem;">
        We're onboarding a first cohort of brands. Tell us where to reach you and
        roughly how many units you ship — we'll reserve your spot.
      </p>
      <WaitlistForm />
    </section>
  </main>
</Base>

<style>
  .hero {
    padding-top: 3rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
  }
  .hero .sub {
    max-width: 38rem;
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .primary {
    background: var(--color-jade);
    color: var(--color-basalt);
    font-weight: 600;
    border-radius: 4px;
    padding: 0.8rem 1.4rem;
  }
  .primary:hover {
    background: var(--color-jade-deep);
  }
  .secondary {
    border: 1px solid var(--color-etch);
    border-radius: 4px;
    padding: 0.8rem 1.4rem;
    color: var(--color-limestone-dim);
  }
  .secondary:hover {
    color: var(--color-limestone);
  }
  .steps,
  .grid2 {
    display: grid;
    gap: 1rem;
    margin-top: 1.4rem;
  }
  .steps {
    grid-template-columns: repeat(3, 1fr);
  }
  .grid2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .step-n {
    font-family: var(--font-mono);
    color: var(--color-jade);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
  }
  h2 {
    margin-top: 0.4rem;
    font-size: 1.7rem;
  }
  .card h3 {
    margin: 0.4rem 0 0.5rem;
    font-size: 1.1rem;
  }
  .card p {
    font-size: 0.9rem;
  }
  @media (max-width: 720px) {
    .steps,
    .grid2 {
      grid-template-columns: 1fr;
    }
  }
</style>
