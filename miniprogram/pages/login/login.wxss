/* v60.3 微信一键登录页：web-view 铺满整页且不支持覆盖原生组件，故登录必须独立成页。
   配色与网页端同源。v66.6 起随全站色调「极光靛紫」：靛紫 #5b4cf0 / 微紫冷白底 #f4f4f9 / 品牌渐变靛紫→蓝→青；
   协议行与勾选框按对比度取值（文字 ≥4.5:1、勾选框描边 ≥3:1）；错误提示保持红 #c0392b（与网页端告警红一致）。 */
page{background:#f4f4f9}
.wrap{min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:0 40rpx;box-sizing:border-box}
.brand{margin-top:190rpx;display:flex;flex-direction:column;align-items:center}
.mark{width:112rpx;height:112rpx;border-radius:32rpx;background:linear-gradient(96deg,#5b4cf0,#3366ee 55%,#0891b2 110%);position:relative}
.l{position:absolute;left:26rpx;right:26rpx;height:8rpx;border-radius:4rpx;background:#fff}
.l1{top:34rpx} .l2{top:54rpx} .l3{top:74rpx}
.dot{position:absolute;right:28rpx;top:24rpx;width:26rpx;height:26rpx;border-radius:50%;background:#fff}
.name{margin-top:26rpx;font-size:44rpx;font-weight:700;color:#1b1a2e;letter-spacing:4rpx}
.sub{margin-top:8rpx;font-size:26rpx;color:#5c5b73;letter-spacing:2rpx}
.pitch{margin-top:70rpx;text-align:center}
.p1{font-size:29rpx;color:#1b1a2e;line-height:1.7}
.p2{margin-top:10rpx;font-size:25rpx;color:#5c5b73}
.go{margin-top:96rpx;width:100%;height:96rpx;line-height:96rpx;border-radius:20rpx;border:none;
  background:#5b4cf0;color:#fff;font-size:32rpx;font-weight:700}
.go[disabled]{opacity:.6;background:#5b4cf0;color:#fff}
.err{margin-top:24rpx;font-size:25rpx;color:#c0392b;text-align:center;line-height:1.6}
.alt{margin-top:28rpx;width:100%;height:92rpx;line-height:92rpx;border-radius:20rpx;
  background:transparent;color:#4a3ad6;font-size:30rpx;font-weight:600;border:2rpx solid #4a3ad6}
.alt::after{border:none}
.skip{margin-top:28rpx;font-size:27rpx;color:#5c5b73;padding:16rpx 28rpx}
/* v60.85 过审整改：底部由「登录即同意」改为勾选框行（默认不勾），点击整行切换勾选态 */
.tos{position:fixed;left:40rpx;right:40rpx;bottom:60rpx;display:flex;align-items:center;justify-content:center;
  font-size:23rpx;color:#6a6981;line-height:1.7;padding:12rpx 0}
.box{width:30rpx;height:30rpx;margin-right:12rpx;border-radius:8rpx;border:2rpx solid #82819c;
  display:flex;align-items:center;justify-content:center;font-size:22rpx;color:#fff;background:#fff;flex:none}
.box.on{background:#5b4cf0;border-color:#5b4cf0}
.lk{color:#4a3ad6}
