/* v60.3 微信一键登录页：web-view 铺满整页且不支持覆盖原生组件，故登录必须独立成页。
   配色与网页端同源（朱砂 #c33a29 / 暖米底 #f3f0e8）。 */
page{background:#f3f0e8}
.wrap{min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:0 40rpx;box-sizing:border-box}
.brand{margin-top:190rpx;display:flex;flex-direction:column;align-items:center}
.mark{width:112rpx;height:112rpx;border-radius:32rpx;background:linear-gradient(96deg,#c33a29,#d24a37 55%,#e2705d);position:relative}
.l{position:absolute;left:26rpx;right:26rpx;height:8rpx;border-radius:4rpx;background:#fff}
.l1{top:34rpx} .l2{top:54rpx} .l3{top:74rpx}
.dot{position:absolute;right:28rpx;top:24rpx;width:26rpx;height:26rpx;border-radius:50%;background:#fff}
.name{margin-top:26rpx;font-size:44rpx;font-weight:700;color:#20211d;letter-spacing:4rpx}
.sub{margin-top:8rpx;font-size:26rpx;color:#6b6357;letter-spacing:2rpx}
.pitch{margin-top:70rpx;text-align:center}
.p1{font-size:29rpx;color:#20211d;line-height:1.7}
.p2{margin-top:10rpx;font-size:25rpx;color:#6b6357}
.go{margin-top:96rpx;width:100%;height:96rpx;line-height:96rpx;border-radius:20rpx;border:none;
  background:#c33a29;color:#fff;font-size:32rpx;font-weight:700}
.go[disabled]{opacity:.6;background:#c33a29;color:#fff}
.err{margin-top:24rpx;font-size:25rpx;color:#c0392b;text-align:center;line-height:1.6}
.alt{margin-top:28rpx;width:100%;height:92rpx;line-height:92rpx;border-radius:20rpx;
  background:transparent;color:#c33a29;font-size:30rpx;font-weight:600;border:2rpx solid #c33a29}
.alt::after{border:none}
.skip{margin-top:28rpx;font-size:27rpx;color:#6b6357;padding:16rpx 28rpx}
.tos{position:fixed;left:40rpx;right:40rpx;bottom:60rpx;text-align:center;font-size:23rpx;color:#8a8378;line-height:1.7}
.lk{color:#c33a29}
