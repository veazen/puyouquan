<view class="wrap">
  <view class="brand">
    <view class="mark"><view class="l l1"></view><view class="l l2"></view><view class="l l3"></view><view class="dot"></view></view>
    <view class="name">谱友圈</view>
    <view class="sub">智能曲谱平台</view>
  </view>

  <view class="pitch">
    <view class="p1">登录后可收藏曲谱、云端同步、跨设备接着弹</view>
    <view class="p2">与网页端同一个账号</view>
  </view>

  <button class="go" open-type="getPhoneNumber" bindgetphonenumber="onPhone" loading="{{busy}}" disabled="{{busy}}">
    微信一键登录
  </button>
  <view class="err" wx:if="{{err}}">{{err}}</view>
  <view class="skip" bindtap="onSkip">先随便看看</view>

  <view class="tos">登录即表示同意<text class="lk" bindtap="onTos">用户协议</text>与<text class="lk" bindtap="onPri">隐私政策</text></view>
</view>
