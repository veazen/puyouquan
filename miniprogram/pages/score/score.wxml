<web-view wx:if="{{src && !spa}}" src="{{src}}" bindmessage="onMsg" bindload="onWvLoad"></web-view>
<!-- v60.79 朋友圈单页模式占位页（该模式不支持 web-view）：提示走顶部「前往小程序」 -->
<view wx:if="{{spa}}" style="padding:140rpx 56rpx;text-align:center;color:#1f3a34">
  <view style="font-size:44rpx;font-weight:700;margin-bottom:28rpx">谱友圈 · 曲谱</view>
  <view style="font-size:30rpx;color:#666;line-height:1.9">朋友圈预览模式无法直接打开谱面</view>
  <view style="font-size:30rpx;color:#666;line-height:1.9">点击上方「前往小程序」查看完整曲谱</view>
  <view style="font-size:28rpx;color:#999;margin-top:20rpx">可播放 · 可移调 · 可跟谱</view>
</view>
